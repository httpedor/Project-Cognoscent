<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tools\ComponentGenerator\ComponentGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Allow disabling via /p:GenerateTsPackets=false to avoid recursion in child builds -->
    <GenerateTsPackets Condition="'$(GenerateTsPackets)' == ''">true</GenerateTsPackets>
    <GenerateSchema Condition="'$(GenerateSchema)' == ''">true</GenerateSchema>
  </PropertyGroup>
  <!-- Generate TS only when the output is missing or older than the RPG assembly -->
  <Target Name="GenerateTsPackets" AfterTargets="Build" Condition="'$(GenerateTsPackets)' == 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SkipRpgPostBuild)' != 'true'" Inputs="$(TargetPath)" Outputs="$(MSBuildProjectDirectory)\..\WebFrontend\src\networking.generated.ts">
    <PropertyGroup>
      <DotNetExe>$(DotNetHostPath)</DotNetExe>
      <DotNetExe Condition="'$(DotNetExe)' == ''">dotnet</DotNetExe>
      <PacketTsGenProj>$(MSBuildProjectDirectory)\..\Tools\PacketTsGen\PacketTsGen.csproj</PacketTsGenProj>
      <TsOutPath>$(MSBuildProjectDirectory)\..\WebFrontend\src\networking.generated.ts</TsOutPath>
      <RpgDll>$(TargetPath)</RpgDll>
    </PropertyGroup>
    <Message Text="[Rpg] Generating TypeScript packets to $(TsOutPath) ..." Importance="High" />
    <!-- Build the generator for the current configuration to ensure availability -->
    <!-- Make the generator build/run non-fatal so a generator issue doesn't break normal library builds -->
    <Exec Command="$(DotNetExe) build $(PacketTsGenProj) -c $(Configuration)" ContinueOnError="WarnAndContinue" />
    <!-- Run via dotnet run to avoid path/quoting/env issues -->
    <Exec Command="$(DotNetExe) run --no-build --project $(PacketTsGenProj) -c $(Configuration) -- $(RpgDll) $(TsOutPath)" ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Write the auto-generated expression + tag JSON schemas to disk after build -->
  <Target Name="WriteSchemas" AfterTargets="Build" Condition="'$(GenerateSchema)' == 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SkipRpgPostBuild)' != 'true'">
    <PropertyGroup>
      <_SchemaWriterProj>$(MSBuildProjectDirectory)\..\Tools\SchemaWriter\SchemaWriter.csproj</_SchemaWriterProj>
      <_ExprSchemaPath>$(MSBuildProjectDirectory)\..\schemas\_expr.schema.json</_ExprSchemaPath>
      <_TagsSchemaPath>$(MSBuildProjectDirectory)\..\schemas\_tags.schema.json</_TagsSchemaPath>
    </PropertyGroup>
    <Message Text="[Rpg] Writing schemas to $(_ExprSchemaPath) and $(_TagsSchemaPath) ..." Importance="High" />
    <Exec Command="dotnet build $(_SchemaWriterProj) -c $(Configuration) /p:SkipRpgPostBuild=true" ContinueOnError="WarnAndContinue" />
    <Exec Command="dotnet run --no-build --project $(_SchemaWriterProj) -c $(Configuration) -- $(_ExprSchemaPath) $(_TagsSchemaPath)" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>