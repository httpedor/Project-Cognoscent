{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compiler expression schema",
  "description": "JSON schema for expressions accepted by Rpg.Scripting.CompileContext (see Compiler.cs)",
  "oneOf": [
    { "$ref": "#/definitions/numberExpr" },
    { "$ref": "#/definitions/conditionExpr" },
    { "$ref": "#/definitions/effectExpr" },
    { "$ref": "#/definitions/selectorExpr" },
    { "$ref": "#/definitions/stringExpr" },
    { "$ref": "#/definitions/compendiumEntry" }
  ],

  "definitions": {
    "numberExpr": {
      "anyOf": [
        { "type": "number" },
        { "type": "string", "description": "variable name or dice/range shorthand (e.g. 'STR', '1d6', '2-5')" },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "type": "string" },

            "min": { "$ref": "#/definitions/numberExpr" },
            "max": { "$ref": "#/definitions/numberExpr" },
            "t": { "$ref": "#/definitions/numberExpr" },
            "numbers": { "type": "array", "items": { "$ref": "#/definitions/numberExpr" } },

            "stat": { "type": "string" },
            "entity": { "$ref": "#/definitions/selectorExpr" },
            "default": { "$ref": "#/definitions/numberExpr" }
          },
          "additionalProperties": false,
          "examples": [
            { "op": "lerp", "min": 0, "max": 10, "t": 0.5 },
            { "op": "rand", "min": 1, "max": "STR" },
            { "op": "sum", "numbers": ["STR", 2, { "op": "rand", "min": 1, "max": 4 }] },
            { "op": "stat", "stat": "HEALTH", "entity": "target", "default": 0 }
          ]
        }
      ]
    },

    "conditionExpr": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "string", "description": "symbol name or percentage (e.g. '50%')", "pattern": "^.*$" },
        { "type": "number", "description": "probability value (0-1 recommended; >1 treated as percent by compiler)" },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "type": "string" },
            "conditions": { "type": "array", "items": { "$ref": "#/definitions/conditionExpr" } },
            "condition": { "$ref": "#/definitions/conditionExpr" },
            "left": { "$ref": "#/definitions/numberExpr" },
            "right": { "$ref": "#/definitions/numberExpr" },
            "name": { "type": "string" },
            "probability": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false,
          "examples": [
            { "op": "and", "conditions": ["ALIVE", { "op": ">", "left": "HP", "right": 0 }] },
            { "op": "random", "probability": 0.25 },
            { "op": "var", "name": "HAS_KEY" },
            { "op": ">", "left": "STR", "right": 10 }
          ]
        }
      ]
    },

    "effectExpr": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean", "enum": [false] },
        {
          "type": "object",
          "required": ["effect"],
          "properties": { "effect": { "type": "string" } },
          "additionalProperties": false,
          "examples": [ { "effect": "noeffect" } ]
        }
      ]
    },

    "selectorExpr": {
      "anyOf": [
        { "type": "string", "description": "caller, target, target_part, or a symbol name" },
        {
          "type": "object",
          "required": ["selector"],
          "properties": { "selector": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },

    "stringExpr": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "type": "string" },
            "argument": { "type": "string" }
          },
          "additionalProperties": false,
          "examples": [ { "op": "argumentType", "argument": "weapon" } ]
        }
      ]
    },

    "compendiumEntry": {
      "$ref": "#/definitions/stringExpr",
      "description": "a string expression that resolves to a compendium entry id"
    }
  }
}
