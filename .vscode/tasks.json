{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/TTRpgClient.sln",
				"/p:GenerateTsPackets=false",
				"/p:GenerateSchema=false",
				"/property:GenerateFullPaths=false"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Generate TS Packets",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/TTRpgClient.sln",
				"/p:GenerateTsPackets=true",
				"/p:GenerateSchema=false",
				"/property:GenerateFullPaths=true"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "Generate Schemas",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/TTRpgClient.sln",
				"/p:GenerateSchema=true",
				"/p:GenerateTsPackets=false",
				"/property:GenerateFullPaths=true"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "watch",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/TTRpgClient.sln"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build web",
			"command": "npm",
			"type": "process",
			"args": [
				"run",
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}/WebFrontend"
			},
			"problemMatcher": []
		}
	]
}