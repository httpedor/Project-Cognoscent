{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_expr.schema.json",
  "title": "Shared expression definitions",
  "description": "Reusable $defs for all expression types used by ExpressionCompiler. Auto-generated — do not edit manually.",
  "$defs": {
    "NumberExpr": {
      "description": "A numeric expression (Expr<float>). Can be a constant, dice/range shorthand, indexed variable, or an object with an 'op' field.",
      "oneOf": [
        { "type": "number", "description": "Numeric constant, e.g. 3.5" },
        { "type": "string", "description": "Dice notation ('1d6', '2D8', '1-4', '3:6'), or indexed variable ('$0', '$1', ...)." },
        {
          "type": "object",
          "description": "Conditional expression (if/then/else).",
          "required": ["op", "condition", "true", "false"],
          "properties": {
            "op": { "const": "if" },
            "condition": { "$ref": "#/$defs/ConditionExpr" },
            "true": { "$ref": "#/$defs/NumberExpr" },
            "false": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "numbers"],
          "properties": {
            "op": { "enum": ["sum", "plus", "add", "addition", "+"] },
            "numbers": { "type": "array", "items": { "$ref": "#/$defs/NumberExpr" }, "description": "Array of numbers to sum" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "numbers"],
          "properties": {
            "op": { "enum": ["sub", "subtract", "minus", "subtraction", "-"] },
            "numbers": { "type": "array", "items": { "$ref": "#/$defs/NumberExpr" }, "description": "Array of numbers to subtract sequentially" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "numbers"],
          "properties": {
            "op": { "enum": ["mul", "multiply", "times", "multiplication", "*"] },
            "numbers": { "type": "array", "items": { "$ref": "#/$defs/NumberExpr" }, "description": "Array of numbers to multiply" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "numbers"],
          "properties": {
            "op": { "enum": ["div", "divide", "division", "/"] },
            "numbers": { "type": "array", "items": { "$ref": "#/$defs/NumberExpr" }, "description": "Array of numbers to divide sequentially" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "min", "max", "t"],
          "properties": {
            "op": { "enum": ["lerp"] },
            "min": { "$ref": "#/$defs/NumberExpr" },
            "max": { "$ref": "#/$defs/NumberExpr" },
            "t": { "$ref": "#/$defs/NumberExpr", "description": "Interpolation factor (0-1)" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "min", "max"],
          "properties": {
            "op": { "enum": ["rand", "random", "range"] },
            "min": { "$ref": "#/$defs/NumberExpr" },
            "max": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "stat"],
          "properties": {
            "op": { "enum": ["stat", "creature_stat", "entity_stat", "entitystat", "creaturestat"] },
            "stat": { "type": "string", "description": "Name of the stat to read" },
            "entity": { "$ref": "#/$defs/SelectorExpr", "description": "Entity to read stat from (defaults to caller)" },
            "default": { "$ref": "#/$defs/NumberExpr", "description": "Default value if stat not found (defaults to 0)" }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "ConditionExpr": {
      "description": "A boolean/condition expression (Expr<bool>).",
      "oneOf": [
        { "type": "boolean", "description": "Constant true or false." },
        { "type": "null", "description": "Equivalent to false." },
        { "type": "number", "minimum": 0, "description": "Probability check: 0-1 as a fraction, >1 treated as percentage divided by 100." },
        { "type": "string", "description": "Constant 'true'/'false', probability as 'N%', or indexed variable '$N'." },
        {
          "type": "object",
          "description": "Conditional expression (if/then/else).",
          "required": ["op", "condition", "true", "false"],
          "properties": {
            "op": { "const": "if" },
            "condition": { "$ref": "#/$defs/ConditionExpr" },
            "true": { "$ref": "#/$defs/ConditionExpr" },
            "false": { "$ref": "#/$defs/ConditionExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "enum": ["true"] }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "enum": ["false"] }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "enum": ["random", "rand"] },
            "probability": { "$ref": "#/$defs/NumberExpr", "description": "Probability value 0-1 (defaults to 0.5)" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "conditions"],
          "properties": {
            "op": { "enum": ["and"] },
            "conditions": { "type": "array", "items": { "$ref": "#/$defs/ConditionExpr" } }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "conditions"],
          "properties": {
            "op": { "enum": ["or"] },
            "conditions": { "type": "array", "items": { "$ref": "#/$defs/ConditionExpr" } }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "condition"],
          "properties": {
            "op": { "enum": ["not"] },
            "condition": { "$ref": "#/$defs/ConditionExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": [">"] },
            "left": { "$ref": "#/$defs/NumberExpr" },
            "right": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": ["<="] },
            "left": { "$ref": "#/$defs/NumberExpr" },
            "right": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": ["<"] },
            "left": { "$ref": "#/$defs/NumberExpr" },
            "right": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": [">="] },
            "left": { "$ref": "#/$defs/NumberExpr" },
            "right": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": ["=", "=="] },
            "left": { "$ref": "#/$defs/NumberExpr" },
            "right": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": ["!="] },
            "left": { "$ref": "#/$defs/NumberExpr" },
            "right": { "$ref": "#/$defs/NumberExpr" }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "EffectExpr": {
      "description": "An effect expression (EffectExpr).",
      "oneOf": [
        { "type": ["null", "boolean"], "enum": [null, false], "description": "No effect." },
        {
          "type": "object",
          "required": ["effect", "injury", "target"],
          "properties": {
            "effect": { "enum": ["add_injury", "addinjury", "injury", "hurt"] },
            "injury": { "type": "string", "description": "Injury model definition" },
            "target": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "injury", "target"],
          "properties": {
            "effect": { "enum": ["heal_injury", "healinjury"] },
            "injury": { "$ref": "#/$defs/StringExpr", "description": "Injury type compendium ID" },
            "target": { "$ref": "#/$defs/SelectorExpr" },
            "amount": { "$ref": "#/$defs/NumberExpr", "description": "Amount to heal (omit to remove entirely)" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect"],
          "properties": {
            "effect": { "enum": ["null", "nop", "noeffect", "no_effect"] }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "effects"],
          "properties": {
            "effect": { "enum": ["composite"] },
            "effects": { "type": "array", "items": { "$ref": "#/$defs/EffectExpr" } }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "feature", "target"],
          "properties": {
            "effect": { "enum": ["add_feature", "addfeature", "add_feat", "add_condition", "addcondition"] },
            "feature": { "$ref": "#/$defs/StringExpr", "description": "Compendium feature ID" },
            "target": { "$ref": "#/$defs/SelectorExpr" },
            "ticks": { "$ref": "#/$defs/NumberExpr", "description": "Duration in ticks (creates a timed condition)" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "feature", "target"],
          "properties": {
            "effect": { "enum": ["remove_feature", "removefeature", "remove_feat"] },
            "feature": { "$ref": "#/$defs/StringExpr", "description": "Compendium feature ID to remove" },
            "target": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "stat", "value", "target"],
          "properties": {
            "effect": { "enum": ["setstat", "set_stat"] },
            "stat": { "type": "string", "description": "Name of the stat to set" },
            "value": { "$ref": "#/$defs/NumberExpr" },
            "target": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "stat", "value", "target"],
          "properties": {
            "effect": { "enum": ["addstat", "add_stat"] },
            "stat": { "type": "string" },
            "value": { "$ref": "#/$defs/NumberExpr" },
            "target": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "stat", "value", "target"],
          "properties": {
            "effect": { "enum": ["substat", "sub_stat", "remove_stat", "removestat"] },
            "stat": { "type": "string" },
            "value": { "$ref": "#/$defs/NumberExpr" },
            "target": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "stat", "value", "target"],
          "properties": {
            "effect": { "enum": ["mulstat", "mul_stat"] },
            "stat": { "type": "string" },
            "value": { "$ref": "#/$defs/NumberExpr" },
            "target": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["effect", "stat", "value", "target"],
          "properties": {
            "effect": { "enum": ["divstat", "div_stat"] },
            "stat": { "type": "string" },
            "value": { "$ref": "#/$defs/NumberExpr" },
            "target": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "SelectorExpr": {
      "description": "Selects an Entity (Expr<Entity?>). Can reference caller, target, target_part, or a variable.",
      "oneOf": [
        { "type": "string", "enum": ["self", "caller", "target", "target_part"], "description": "Named fixed selector." },
        { "type": "string", "pattern": "^\\$[0-9]+$", "description": "Indexed variable, e.g. '$0'." },
        { "type": ["null", "boolean"], "enum": [null, false], "description": "No entity / null selector." },
        {
          "type": "object",
          "description": "Conditional expression (if/then/else).",
          "required": ["op", "condition", "true", "false"],
          "properties": {
            "op": { "const": "if" },
            "condition": { "$ref": "#/$defs/ConditionExpr" },
            "true": { "$ref": "#/$defs/SelectorExpr" },
            "false": { "$ref": "#/$defs/SelectorExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "target", "tag"],
          "properties": {
            "op": { "enum": ["part_by_tag", "bp_by_tag", "bodypart_by_tag", "body_part_by_tag"] },
            "target": { "$ref": "#/$defs/SelectorExpr" },
            "tag": { "$ref": "#/$defs/StringExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "target", "name"],
          "properties": {
            "op": { "enum": ["part_by_name", "bp_by_name", "bodypart_by_name", "body_part_by_name"] },
            "target": { "$ref": "#/$defs/SelectorExpr" },
            "name": { "$ref": "#/$defs/StringExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "target", "path"],
          "properties": {
            "op": { "enum": ["part_by_path", "bp_by_path", "bodypart_by_path", "body_part_by_path"] },
            "target": { "$ref": "#/$defs/SelectorExpr" },
            "path": { "$ref": "#/$defs/StringExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "enum": ["caller", "self"] }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "enum": ["target"] }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "enum": ["target_part"] }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "StringExpr": {
      "description": "A string expression (Expr<string>). Can be a literal, indexed variable, or a concat operation.",
      "oneOf": [
        { "type": "string", "description": "String literal or '$N' indexed variable." },
        {
          "type": "object",
          "description": "Conditional expression (if/then/else).",
          "required": ["op", "condition", "true", "false"],
          "properties": {
            "op": { "const": "if" },
            "condition": { "$ref": "#/$defs/ConditionExpr" },
            "true": { "$ref": "#/$defs/StringExpr" },
            "false": { "$ref": "#/$defs/StringExpr" }
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["op", "strings"],
          "properties": {
            "op": { "enum": ["concat", "add", "join"] },
            "strings": { "type": "array", "items": { "$ref": "#/$defs/StringExpr" } }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "StatModifierType": {
      "type": "string",
      "enum": ["Flat", "FlatPostMods", "Percent", "Multiplier", "Capmax", "Capmin", "OverrideBase", "OverrideFinal"],
      "description": "How the modifier value is applied to the stat. Case-insensitive at runtime."
    },
    "ArgumentType": {
      "type": "string",
      "enum": ["entity", "position", "bodypart", "item", "boolean"],
      "description": "A skill argument type identifier."
    }
  }
}
