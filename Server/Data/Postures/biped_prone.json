{
    // Posture for any bipedal creature lying on the ground. Uses it's hand and feet to crawl, so movement speed is based on their strength.
    "default": true,
    "name": "Deitado",
    "maxStability": "= max_float()",
    "stabilityRecovery": 0,
    "idealHeight": 0,
    "heightTolerance": 0.5,
    // Movement speed multiplier = movement intensity * average strength of all hand+foot groups
    // (normalized against 80), since crawling relies on the same limbs as gripping/standing.
    "movement": "= lerp(0.1, 0.04, $0 * with_vars([array_concat(target_component.bps_by_tag('hand'), target_component.bps_by_tag('foot'))], $0.map($0.bp_group()).map(group_stat('strength', $0, caller)).sum() / array_size($0) / 80))"
}