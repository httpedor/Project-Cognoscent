{
    "default": true,
    "name": "De Pé",
    "maxStability": "= (80 + target_component.constitution) * switch array_count(target_component.bps_by_tag('foot').filter(body::bp_groups_alive($0))) { 0 => 0.1, 1 => 0.33, _ => 1 }",
    "stabilityRecovery": "= (50 + target_component.constitution / 2) * switch array_count(target_component.bps_by_tag('foot').filter(body::bp_groups_alive($0))) { 0 => 0, 1 => 0.33333334, _ => 1 }",
    "idealHeight": 1,
    "heightTolerance": 0.25,
    "movement": "= (group_stat('strength', 'lower_left', target_component) + group_stat('strength', 'lower_right', target_component) + target_component.dexterity) / 80",
    "canEnterPosture": "= array_count(target_component.bps_by_tag('foot').filter(body::bp_groups_alive($0))) >= 1",
    "canStayInPosture": "= array_count(target_component.bps_by_tag('foot').filter(body::bp_groups_alive($0))) >= 1"
}