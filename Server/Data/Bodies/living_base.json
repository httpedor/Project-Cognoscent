{
  "layerProfiles": {
    "default": {
      "layers": {
        "skin": {
          "bloodFlow": 1,
          "pain": 1,
          "maxHealth": 1,
          "damageModifiers": {
            "blunt": 0.75
          },
          "resistance": {
            "blunt": 0.25
          }
        },
        "fat": {
          "bloodFlow": "0.4:0.6",
          "maxHealth": "1.1:1.3",
          "damageModifiers": {
            "blunt": 0.75
          },
          "resistance": {
            "blunt": 0.75
          }
        },
        "muscle": {
          "bloodFlow": "2:3",
          "maxHealth": "1.5:2.5",
          "vital": true,
          "damageModifiers": {
            "slash": 1.2,
            "pierce": 0.8,
            "blunt": 0.95
          }
        },
        "bone": {
          "bloodFlow": "0.2:0.3",
          "maxHealth": "4:5.5",
          "vital": true,
          "damageModifiers": [
            // Sharp attacks are less effective against bone
            {
              "condition": "= var_has_tag(1, 'sharp')",
              "operation": "Percent",
              "value": -0.2
            }
          ]
        }
      },
      "order": ["skin", "fat", "muscle", "bone"]
    },

    "boneless": {
      "extends": "default",
      "order": ["skin", "fat", "muscle"],
      "layers": {
      }
    },

    "organ": {
      "layers": {
        "tissue": {
          "bloodFlow": 4,
          "maxHealth": 1,
          "vital": true
        }
      },
      "order": ["tissue"]
    }
  },

  // Maybe respiration should depend on blood_flow, and consciousness should only depend on respiration
  "stats": {
    "strength": {
      "aliases": [
        "str",
        "força",
        "for"
      ],
      "dependsOn": {
        "consciousness": 0.15,
        "blood_flow": 0.5,
        "respiration": 0.5
      },
      "local": true
    },
    "agility": {
      "aliases": [
        "agi",
        "agilidade",
        "agility"
      ],
      "base": 25,
      "dependsOn": {
        "consciousness": 0.15,
        "blood_flow": 0.5,
        "respiration": 0.5
      },
      "local": true
    },
    "dexterity": {
      "aliases": [
        "dex",
        "destreza",
        "des"
      ],
      "base": 10,
      "dependsOn": {
        "consciousness": 1,
        "respiration": 0.5,
        "perception": 1
      }
    },
    "intelligence": {
      "aliases": [
        "int",
        "inteligência"
      ],
      "base": 25,
      "dependsOn": {
        "consciousness": 1.2
      }
    },
    "constitution": {
      "aliases": [
        "con",
        "constituição"
      ],
      "base": 25,
      "dependsOn": {
        "blood_flow": 0.5,
        "respiration": 0.5
      }
    },
    "movement": {
      "aliases": [
        "mov",
        "movimento",
        "velocidade de movimento",
        "move_speed",
        "movement_speed",
        "mov_spd",
        "spd"
      ],
      "base": 5,
      "dependsOn": {
        "agility": {
          "value": "= ($0 - 25) / 7",
          "type": "Flat"
        }
      }
    },
    "sight": {
      "max": 1
    },
    "hearing": {
      "max": 1
    },
    "perception": {
      "dependsOn": {
        "sight": 0.9,
        "hearing": 0.1,
        "consciousness": 0.75
      },
      "max": 1
    },
    "pain_sensitivity": {
      "base": 0,
      "max": 1,
      "min": -1
    },
    "pain": {
      "max": 1,
      "dependsOn": {
        "constitution": {
          // (con - 25) / 100, inverted so that higher constitution means less pain
          "value": "= -1 * (($0 - 25) / 100)",
          "type": "Percent"
        }
      }
    },
    "respiration": {
      "max": 1
    },
    "oxygenation": {
      "dependsOn": {
        "respiration": 1,
        "blood_flow": 0.5
      },
      "max": 1
    },
    "consciousness": {
      "dependsOn": {
        "oxygenation": 0.75,
        "pain": {
          // If pain is above 0.1, consciousness starts to drop, reaching 0 at pain 2.35 (which is above the max of 1, so it will never reach 0 just from pain, but it will get close)
          "value": "= $0 <= 0.1 ? 0 : -1 * (($0 - 0.1) / 2.25)",
          "type": "Percent"
        }
      },
      "overCap": false,
      "max": 1,
      "vital": true,
      "thresholds": [
        {
          // If consciousness drops to 0.3 or below, apply the "Sleeping" feature
          "condition": "= $0 <= 0.3",
          "effect": "= add_feature('sleeping', self)",
          "reverse": "= remove_feature('sleeping', self)"
        }
      ]
    },
    "blood_flow": {
      "max": 1
    }
  }
}