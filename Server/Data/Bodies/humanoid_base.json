{
  "parent": "living_base",
  "icon": "humanoid",
  "tags": ["humanoid"],
  "onHealthChange": [
    {
      // Go prone if all movement bodyparts are dead
      "op": "if",
      "condition": {
        "op": "and",
        "conditions": [
          {
            //Optimization trick to avoid checking all bodyparts if the one damaged doesn't have the "movement" tag
            // since the only way all movement bodyparts are dead is if the damaged one is, we can skip the rest of the checks in that case
            "op": "var_has_tag",
            "tag": "movement",
            "var": "target_part"
          },
          {
            "op": "all",
            "condition": {
              "op": "var_has_tag",
              "tag": "movement",
              "var": "target_part"
            },
            "variables": {
              "op": "part_by_tag",
              "body": {
                "op": "body_from_part",
                "target": "target_part"
              },
              "tag": "movement"
            }
          }
        ]
      },
      "true": {
        "op": "add_feat",
        "target": "self",
        "feature": "prone" // TODO: PRONE feat
      }
    }
  ],
