{
    "name": "Dormindo",
    "description": "Esta entidade está dormindo",
    "type": "simple",
    "icon": "sleeping",
    "statModifiers": {
        // Prevent consciousness from going above 0.3 while sleeping
        "consciousness": [
            {
                "type": "Capmax",
                "value": 0.3
            }
        ]
    },
    "enable": "= composite([caller.change_posture_to_resting(), log(concat([caller.ent_name(), ' foi dormir.']))])",
    "doesExecuteSkill": {
        // Prevent executing any skills while sleeping
        "condition": false,
        "reason": "= concat([caller.ent_name(), ' está dormindo.'])"
    }
}